        "description": "Resource group name. Created if it does not exist."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "Project": "Supercharge Microsoft Fabric",
        "Tutorial": "57-databricks-better-together",
        "ManagedBy": "Bicep"
