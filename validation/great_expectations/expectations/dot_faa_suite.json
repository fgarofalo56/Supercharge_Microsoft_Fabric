{
  "expectation_suite_name": "dot_faa_suite",
  "meta": {
    "great_expectations_version": "0.18.0",
    "notes": "Data quality expectations for DOT/FAA aviation and transportation data",
    "domain": "Department of Transportation & FAA",
    "compliance_requirements": [
      "FAA flight operations reporting",
      "DOT safety incident documentation",
      "BTS traffic statistics accuracy",
      "Infrastructure inspection compliance",
      "NTSB incident data integrity"
    ]
  },
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {
        "min_value": 0,
        "max_value": null
      },
      "meta": {
        "notes": "Table may have zero records during initial ingestion"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "record_id"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "carrier_code"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "airport_code"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "record_type"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "event_date"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "record_id"
      },
      "meta": {
        "notes": "Record ID is required - primary identifier"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "carrier_code"
      },
      "meta": {
        "notes": "Carrier code is required for airline identification"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "airport_code"
      },
      "meta": {
        "notes": "Airport code is required for location identification"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "record_type"
      },
      "meta": {
        "notes": "Record type is required for classification"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "event_date"
      },
      "meta": {
        "notes": "Event date is required for temporal tracking"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "record_id"
      },
      "meta": {
        "notes": "Record ID must be unique"
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "record_id",
        "regex": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
        "mostly": 0.95
      },
      "meta": {
        "notes": "Record ID should be UUID format"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "record_type",
        "value_set": [
          "flight_operation",
          "safety_incident",
          "traffic_statistic",
          "infrastructure_inspection"
        ]
      },
      "meta": {
        "notes": "Valid DOT/FAA record types"
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "carrier_code",
        "regex": "^[A-Z0-9]{2,3}$"
      },
      "meta": {
        "notes": "Carrier code must be 2-3 character IATA airline code (e.g., AA, UA, DL)"
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "airport_code",
        "regex": "^[A-Z]{3,4}$"
      },
      "meta": {
        "notes": "Airport code must be 3-4 character ICAO/IATA code (e.g., LAX, KJFK)"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_dateutil_parseable",
      "kwargs": {
        "column": "event_date"
      },
      "meta": {
        "notes": "Event date must be parseable"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "severity",
        "value_set": ["minor", "moderate", "major", "critical", null]
      },
      "meta": {
        "notes": "Valid severity levels for incidents and inspections"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "status",
        "value_set": ["open", "under_investigation", "closed", "resolved", null]
      },
      "meta": {
        "notes": "Valid record status values"
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "flight_number",
        "regex": "^[A-Z0-9]{2,3}[0-9]{1,4}$",
        "mostly": 0.90
      },
      "meta": {
        "notes": "Flight number format: carrier code + 1-4 digit number when present"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "delay_minutes",
        "min_value": 0,
        "max_value": null,
        "mostly": 0.95
      },
      "meta": {
        "notes": "Delay in minutes must be non-negative when present"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "passenger_count",
        "min_value": 0,
        "max_value": null,
        "mostly": 0.95
      },
      "meta": {
        "notes": "Passenger count must be non-negative when present"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "aircraft_category",
        "value_set": [
          "narrow_body",
          "wide_body",
          "regional_jet",
          "turboprop",
          "general_aviation",
          "cargo",
          "helicopter",
          null
        ]
      },
      "meta": {
        "notes": "Valid aircraft category classifications"
      }
    },
    {
      "expectation_type": "expect_column_value_lengths_to_be_between",
      "kwargs": {
        "column": "description",
        "min_value": 0,
        "max_value": 2000,
        "mostly": 0.99
      },
      "meta": {
        "notes": "Description should not exceed 2000 characters"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "reporting_agency",
        "value_set": ["FAA", "NTSB", "BTS", "DOT", "TSA", null]
      },
      "meta": {
        "notes": "Valid federal reporting agencies"
      }
    }
  ]
}
