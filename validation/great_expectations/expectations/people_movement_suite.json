{
  "expectation_suite_name": "people_movement_suite",
  "meta": {
    "great_expectations_version": "0.18.0",
    "notes": "Data quality expectations for people movement and occupancy tracking data",
    "domain": "People Movement & Occupancy Analytics",
    "compliance_requirements": [
      "Occupancy limit monitoring",
      "Zone capacity enforcement",
      "Sensor calibration accuracy",
      "Privacy-compliant counting (no PII)"
    ]
  },
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {
        "min_value": 0,
        "max_value": null
      },
      "meta": {
        "notes": "Table may have zero records during closed periods"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "event_id"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "zone_id"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "sensor_type"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "timestamp"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "person_count"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "event_id"
      },
      "meta": {
        "notes": "Event ID is required - primary identifier"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "zone_id"
      },
      "meta": {
        "notes": "Zone ID is required for location tracking"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "sensor_type"
      },
      "meta": {
        "notes": "Sensor type is required for data source attribution"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "timestamp"
      },
      "meta": {
        "notes": "Timestamp is required for time-series analysis"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "person_count"
      },
      "meta": {
        "notes": "Person count is required for occupancy tracking"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "event_id"
      },
      "meta": {
        "notes": "Event ID must be unique"
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "event_id",
        "regex": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
        "mostly": 0.95
      },
      "meta": {
        "notes": "Event ID should be UUID format"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "sensor_type",
        "value_set": [
          "infrared",
          "camera",
          "bluetooth",
          "wifi",
          "pressure_mat",
          "lidar"
        ]
      },
      "meta": {
        "notes": "Valid sensor types for people counting"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "person_count",
        "min_value": 0,
        "max_value": null
      },
      "meta": {
        "notes": "Person count must be a non-negative integer"
      }
    },
    {
      "expectation_type": "expect_column_value_lengths_to_be_between",
      "kwargs": {
        "column": "zone_id",
        "min_value": 1,
        "max_value": 50
      },
      "meta": {
        "notes": "Zone ID must be a non-empty string with reasonable length"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_dateutil_parseable",
      "kwargs": {
        "column": "timestamp"
      },
      "meta": {
        "notes": "Timestamp must be parseable"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "direction",
        "value_set": ["in", "out", "through", "stationary", null]
      },
      "meta": {
        "notes": "Valid movement direction values"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "occupancy_pct",
        "min_value": 0.0,
        "max_value": 100.0,
        "mostly": 0.99
      },
      "meta": {
        "notes": "Occupancy percentage must be between 0% and 100%"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "dwell_time_seconds",
        "min_value": 0,
        "max_value": null,
        "mostly": 0.95
      },
      "meta": {
        "notes": "Dwell time must be non-negative when present"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "sensor_accuracy",
        "min_value": 0.0,
        "max_value": 1.0,
        "mostly": 0.95
      },
      "meta": {
        "notes": "Sensor accuracy score must be between 0.0 and 1.0 when present"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "alert_triggered",
        "value_set": [true, false, null]
      },
      "meta": {
        "notes": "Alert triggered flag must be boolean or null"
      }
    }
  ]
}
