{
  "expectation_suite_name": "tribal_healthcare_suite",
  "meta": {
    "great_expectations_version": "0.18.0",
    "notes": "Data quality expectations for tribal healthcare encounter and clinical data",
    "domain": "Tribal Healthcare (IHS)",
    "compliance_requirements": [
      "HIPAA compliance for protected health information",
      "Indian Health Service (IHS) reporting standards",
      "PII hashing for patient identifiers",
      "CMS encounter data integrity",
      "Tribal sovereignty data governance"
    ]
  },
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {
        "min_value": 0,
        "max_value": null
      },
      "meta": {
        "notes": "Table may have zero records during initial ingestion"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "encounter_id"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "patient_id"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "facility_id"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "encounter_type"
      }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": {
        "column": "encounter_date"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "encounter_id"
      },
      "meta": {
        "notes": "Encounter ID is required - primary identifier"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "patient_id"
      },
      "meta": {
        "notes": "Patient ID is required - must be hashed for HIPAA compliance"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "facility_id"
      },
      "meta": {
        "notes": "Facility ID is required for IHS reporting"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "encounter_type"
      },
      "meta": {
        "notes": "Encounter type is required for classification"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "encounter_date"
      },
      "meta": {
        "notes": "Encounter date is required for clinical timeline"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "encounter_id"
      },
      "meta": {
        "notes": "Encounter ID must be unique"
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "encounter_id",
        "regex": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
        "mostly": 0.95
      },
      "meta": {
        "notes": "Encounter ID should be UUID format"
      }
    },
    {
      "expectation_type": "expect_column_value_lengths_to_equal",
      "kwargs": {
        "column": "patient_id",
        "value": 64
      },
      "meta": {
        "notes": "Patient ID must be 64 characters (SHA-256 hex digest) for HIPAA-compliant hashing"
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "patient_id",
        "regex": "^[a-fA-F0-9]{64}$"
      },
      "meta": {
        "notes": "Patient ID must be valid hexadecimal SHA-256 hash"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "encounter_type",
        "value_set": [
          "inpatient",
          "outpatient",
          "emergency",
          "telehealth",
          "dental",
          "behavioral_health"
        ]
      },
      "meta": {
        "notes": "Valid encounter types for IHS facilities"
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "facility_id",
        "regex": "^[A-Z0-9]{3,10}$"
      },
      "meta": {
        "notes": "Facility ID must follow IHS facility code format"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_dateutil_parseable",
      "kwargs": {
        "column": "encounter_date"
      },
      "meta": {
        "notes": "Encounter date must be parseable"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_dateutil_parseable",
      "kwargs": {
        "column": "discharge_date",
        "mostly": 0.90
      },
      "meta": {
        "notes": "Discharge date must be parseable when present (not all encounters have discharge)"
      }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "primary_diagnosis_code",
        "regex": "^[A-Z][0-9]{2}(\\.[0-9A-Z]{1,4})?$",
        "mostly": 0.95
      },
      "meta": {
        "notes": "Primary diagnosis should follow ICD-10-CM format when present"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "service_category",
        "value_set": [
          "primary_care",
          "specialty",
          "pharmacy",
          "laboratory",
          "radiology",
          "behavioral_health",
          "dental",
          "optometry",
          "physical_therapy",
          "community_health",
          null
        ]
      },
      "meta": {
        "notes": "Valid IHS service categories"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "payment_source",
        "value_set": [
          "IHS_DIRECT",
          "MEDICAID",
          "MEDICARE",
          "PRIVATE_INSURANCE",
          "SELF_PAY",
          "TRIBAL_PROGRAM",
          "VA",
          null
        ]
      },
      "meta": {
        "notes": "Valid payment sources for tribal healthcare"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "disposition",
        "value_set": [
          "discharged",
          "admitted",
          "transferred",
          "left_against_advice",
          "deceased",
          null
        ]
      },
      "meta": {
        "notes": "Valid encounter disposition values"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "total_charges",
        "min_value": 0,
        "max_value": null,
        "mostly": 0.99
      },
      "meta": {
        "notes": "Total charges must be non-negative when present"
      }
    }
  ]
}
