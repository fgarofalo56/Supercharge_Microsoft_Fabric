// Dev Container for Supercharge Microsoft Fabric POC
// https://aka.ms/devcontainer.json
{
  "name": "Supercharge Microsoft Fabric Dev",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  // Dev Container Features
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },

  // VS Code customizations
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.azurecli",
        "ms-azuretools.vscode-bicep",
        "ms-toolsai.jupyter",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "validation",
          "-v",
          "--tb=short"
        ],
        "python.testing.unittestEnabled": false,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      }
    }
  },

  // Install dependencies after container creation
  "postCreateCommand": "pip install --upgrade pip && pip install pyspark pytest great-expectations faker numpy pandas delta-spark",

  // Port forwarding
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit",
      "onAutoForward": "notify"
    }
  },

  // Environment variables
  "remoteEnv": {
    "FABRIC_POC_HASH_SALT": "${localEnv:FABRIC_POC_HASH_SALT:CHANGE_ME_BEFORE_USE}",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1"
  },

  "remoteUser": "vscode"
}
